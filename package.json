{
  "name": "tarefas-cli",
  "version": "1.0.0",
  "description": "Gerenciador de tarefas na linha de comando, escrito em TypeScript.",
  "type": "module",
  "bin": {
    "tarefas": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
